	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.236345953761-9m1hrq23udi96mmiv75b3fqt7uft0j6k</string>
			</array>
		</dict>
	</array>

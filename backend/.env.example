# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB (use MongoDB Atlas for production - free tier available)
MONGODB_URI=mongodb://localhost:27017/nextignition

# JWT Secret (change this in production!)
JWT_SECRET=supersecretkey123

# Admin JWT Secret (separate secret for admin authentication)
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_JWT_SECRET=your-secure-admin-jwt-secret-here

# Admin Credentials (format: username:passwordHash:displayName,username2:passwordHash2:displayName2)
# Generate password hash: node -e "require('bcryptjs').hash('yourpassword',10).then(console.log)"
# Example (DO NOT USE IN PRODUCTION - these are example hashes):
# ADMIN_CREDENTIALS=admin@nextignition.io:$2b$10$example1:Primary Admin,ops@nextignition.io:$2b$10$example2:Operations Admin
ADMIN_CREDENTIALS=

# Official "NextIgnition" resource publishers (comma-separated emails).
# Startup Resources uploaded by these accounts are auto-flagged so they appear
# under the "NextIgnition" tab. (Accounts with data.isOfficial=true or an admin
# role are treated as official too.)
# OFFICIAL_RESOURCE_EMAILS=content@nextignition.com,team@nextignition.com
OFFICIAL_RESOURCE_EMAILS=

# Supabase Configuration (REQUIRED)
# Both variables are required for the backend to start
# Get these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Auth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# Apple Sign-In (iOS native)
# This is your app's bundle ID used as the audience when verifying Apple identity tokens
APPLE_CLIENT_ID=com.nextignition.app

# Razorpay Payment Gateway
# Get keys from: https://dashboard.razorpay.com/app/keys
# Apple Pay: Enable in Razorpay Dashboard → Settings → Payment Methods → Apple Pay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CORS Origins (comma-separated for multiple origins)
# For local dev:
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# For production (set your Vercel URL):
# CORS_ORIGIN=https://your-app.vercel.app

# OpenRouter API Key (get free key at https://openrouter.ai/keys)
# Free models available: meta-llama/llama-3.1-8b-instruct:free
# Leave empty to use mock responses
OPENROUTER_API_KEY=

# Optional model override for pitch deck analysis
# Example: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, meta-llama/llama-3.1-70b-instruct
OPENROUTER_PITCH_DECK_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Optional Bytez fallback (used when OpenRouter/Gemini are unavailable)
# Get key at https://bytez.com (or your Bytez dashboard)
BYTEZ_API_KEY=
BYTEZ_MODEL=google/gemini-2.5-pro

# Gemini API Key (used for Pitch Deck Summarizer PDF/PPT/PPTX analysis)
# Get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model for pitch deck analysis
# Example: gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# Resend Email Configuration
# Get API key from: https://resend.com/api-keys
# Make sure domains are verified in Resend dashboard (support, connect, noreply, spark subdomains)
RESEND_API_KEY=

# Sender identities (must match verified domains in Resend)
# Defaults to these values if left empty
MAIL_FROM_SUPPORT=support@nextignition.com
MAIL_FROM_CONNECT=connect@nextignition.com
MAIL_FROM_NOREPLY=noreply@nextignition.com
MAIL_FROM_SPARK=spark@nextignition.com

# OTP settings (email verification + password reset)
# If not set, defaults to JWT_SECRET and 10 minutes.
OTP_SECRET=
OTP_EXPIRES_MINUTES=10

# ============================================================================
# Phase 2: Enhanced Verification (Optional)
# ============================================================================

# LinkedIn OAuth (Optional - for professional verification)
# Create app at: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/verification/linkedin/callback

# Twilio SMS (Optional - for phone verification)
# Sign up at: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# File Storage (for document uploads)
SUPABASE_STORAGE_BUCKET=verification-documents
MAX_FILE_SIZE=5242880

# Auto-Verification Settings
ENABLE_AUTO_VERIFICATION=true
AUTO_VERIFY_THRESHOLD=85

# News API Configuration (Optional)
# Get key at https://newsapi.org/
# If left empty, a free public mirror will be used as fallback
NEWS_API_KEY=

# ============================================================================
# Play Store install stats (Optional - powers the "Play Store Installs" card
# on the admin dashboard). Reads the report CSVs that Play Console exports to
# a Google Cloud Storage bucket. Leave empty to hide the data (card shows "—").
# ============================================================================
# Bucket id WITHOUT the gs:// prefix.
# In Play Console: Download reports -> Statistics -> "Copy Cloud Storage URI"
# (the value looks like gs://pubsite_prod_1234567890 -> use pubsite_prod_1234567890)
PLAY_GCS_BUCKET=
# Base64 of a Google Cloud service-account JSON key that has read access
# (role "Storage Object Viewer") to the bucket above.
# Generate: base64 -w0 service-account.json
PLAY_GCS_SA_JSON_BASE64=
# Android package name (defaults to com.nextignition.app if omitted)
PLAY_APP_PACKAGE=com.nextignition.app


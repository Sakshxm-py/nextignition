{
  "name": "nextignition-server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon -w src -w .env -e ts,env src/index.ts",
    "migrate:supabase": "ts-node src/migrateMongoToSupabase.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:jest": "jest --forceExit --detectOpenHandles",
    "cleanup:demo": "ts-node cleanup_demo_data.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "description": "NextIgnition Backend API",
  "dependencies": {
    "@supabase/supabase-js": "^2.99.1",
    "@types/compression": "^1.8.1",
    "@types/helmet": "^0.0.48",
    "apple-signin-auth": "^2.0.0",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "bytez.js": "^3.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "multer": "^2.0.2",
    "officeparser": "^6.0.4",
    "passport": "^0.7.0",
    "passport-linkedin-oauth2": "^2.0.0",
    "pdf-parse": "^1.1.1",
    "pptxgenjs": "^3.12.0",
    "razorpay": "^2.9.6",
    "resend": "^6.11.0",
    "socket.io": "^4.8.3",
    "twilio": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.3",
    "@types/passport": "^1.0.17",
    "@types/passport-linkedin-oauth2": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
